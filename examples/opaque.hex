
# Arithmetic expression typing.
#
# Wires are types. An input boundary is a typing context: each wire is a
# variable available to the expression, labelled by its type. The output boundary
# is the type of the expression produced by the rule/proof.
(object num : 0 -> 1)

# Primitive typing/evaluation rules for arithmetic expressions.
(arrow zero : [ . ] -> num)
(arrow one : [ . ] -> num)
(arrow neg : num -> num)
(arrow add : {num num} -> num)
(arrow mul : {num num} -> num)

# In a context x : num, y : num, the expression -(x + y) has type num.
(def-arrow neg-sum : {num num} -> num =
  (add neg)
)

# In a context x : num, y : num, the expression (x + y) * 1 has type num.
(def-arrow sum-times-one : {num num} -> num =
  {[x y .]
    ([.x y] add [sum .])
    ([.] one [one .])
    ([.sum one] mul)
  }
)

# Assignment x = (y + z) * 1.
#
# The input context is x : num, y : num, z : num.
# The output context has the same shape, but x is replaced by the value of (y + z) * 1:
#   x' : num, y : num, z : num
(def-arrow assign-x-sum-times-one : {num num num} -> {num num num} =
  {[x y z .]
    ([.y z] sum-times-one)
    [.y]
    [.z]
  }
)

(object state : 0 -> 1)

(arrow unpack : state -> {num num num})
(arrow pack   : {num num num} -> state)

(def-arrow branch : state -> {state state} = [s . s s])

(def-arrow join : {state state} -> state = [s s . s])

(def-arrow assign-x-sum-times-one-state : state -> state =
  (unpack assign-x-sum-times-one pack)
)

(def-arrow program : state -> state =
  (branch
   {
    assign-x-sum-times-one-state 
    assign-x-sum-times-one-state
   }
   join)
)