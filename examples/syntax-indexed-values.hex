################################################################################
# Type descriptions and typed values
################################################################################

# A primitive type description.
(object num : 0 -> 1)
(object bool : 0 -> 1)

# Binary product type description.
(object prod : 2 -> 1)

# val is a unary predicate/object constructor:
#
#   val(T)
#
# means "a value whose type description is T".
(object val : 1 -> 1)


################################################################################
# Generic product values
################################################################################

# Pairing:
#
#   val(A), val(B) -> val(prod(A, B))
#
# Source {val val} has two metavariables A and B.
# Target (prod val) builds prod(A,B), then wraps it with val.
(arrow pair : {val val} -> (prod val))

# First projection:
#
#   val(prod(A, B)) -> val(A)
#
(arrow fst : (prod val) -> ([A B . A] val))

# Second projection:
#
#   val(prod(A, B)) -> val(B)
#
(arrow snd : (prod val) -> ([A B . B] val))


################################################################################
# Generic branch / join for any val(T)
################################################################################

# branch:
#
#   val(T) -> val(T), val(T)
#
# The target is not {val val}, which would introduce two independent
# metavariables. Instead, we copy the same T using [T . T T].
(def-arrow branch : val -> ([T . T T] {val val}) =
  [s . s s]
)

# join:
#
#   val(T), val(T) -> val(T)
#
# The source uses the same shared type T on both inputs.
# The proof [s s . s] also says the two values must agree.
(def-arrow join : ([T . T T] {val val}) -> val =
  [s s . s]
)


################################################################################
# Arithmetic over val(num)
################################################################################

(arrow zero : [ . ] -> (num val))
(arrow one  : [ . ] -> (num val))
(arrow neg  : (num val) -> (num val))
(arrow add  : {(num val) (num val)} -> (num val))
(arrow mul  : {(num val) (num val)} -> (num val))
(arrow true  : [ . ] -> (bool val))
(arrow false : [ . ] -> (bool val))


# -(x + y)
(def-arrow neg-sum : {(num val) (num val)} -> (num val) =
  (add neg)
)

# (x + y) * 1
(def-arrow sum-times-one : {(num val) (num val)} -> (num val) =
  {[x y .]
    ([.x y] add [sum .])
    ([.] one [one .])
    ([.sum one] mul)
  }
)

# (x + y) * 0
(def-arrow sum-times-zero : {(num val) (num val)} -> (num val) =
  {[x y .]
    ([.x y] add [sum .])
    ([.] zero [zero .])
    ([.sum zero] mul)
  }
)


################################################################################
# State type
################################################################################

# State shape:
#
#   num × (num × num)
#
# In object syntax:
#
#   ({num ({num num} prod)} prod)
#
# A value of this state type is therefore:
#
#   ({num ({num num} prod)} prod val)


################################################################################
# Assignment on state
################################################################################

# x := (y + z) * 1
#
# Input:
#
#   s : val(num × (num × num))
#
# Decompose:
#
#   yz = snd(s)
#   y  = fst(yz)
#   z  = snd(yz)
#
# Compute:
#
#   x2 = (y + z) * 1
#
# Rebuild:
#
#   pair(x2, pair(y,z))

(def-arrow assign-x-sum-times-one-state
  : ({num ({num num} prod)} prod val)
 -> ({num ({num num} prod)} prod val)
 =
  {[s .]
    ([.s] snd [yz .])
    ([.yz] fst [y .])
    ([.yz] snd [z .])

    ([.y z] sum-times-one [x2 .])

    ([.y z] pair [yz2 .])
    ([.x2 yz2] pair)
  }
)

(def-arrow assign-x-sum-times-zero-state
  : ({num ({num num} prod)} prod val)
 -> ({num ({num num} prod)} prod val)
 =
  {[s .]
    ([.s] snd [yz .])
    ([.yz] fst [y .])
    ([.yz] snd [z .])

    ([.y z] sum-times-zero [x2 .])

    ([.y z] pair [yz2 .])
    ([.x2 yz2] pair)
  }
)


################################################################################
# Program: branch, run two alternatives, join
################################################################################

(def-arrow program
  : ({num ({num num} prod)} prod val)
 -> ({num ({num num} prod)} prod val)
 =
  (branch
   {
    assign-x-sum-times-one-state
    assign-x-sum-times-zero-state
   }
   join)
)