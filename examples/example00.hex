(object add : 2 -> 1)

(arrow add-gate : [x y . x y] -> ([x y . x y] add))

(def-arrow circuit : [x y z . x y] -> [x y z . x y z] =
  {[x y.]
    [.x]
    [.y]
    ([.x y] add-gate)
  }
)

# this makes SSA decomposition fail because of loop
(def-arrow circuit-with-loop : [x y] -> ([x y] add [z.x y z]) =
  {[x y.]
    [.x]
    [.y]
    ([.x y] add-gate)
  }
)