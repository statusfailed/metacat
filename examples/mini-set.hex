  # imbi1i: |- ( ( ph -> ch ) <-> ( ps -> ch ) )
  (def imbi1i
    : ([ph ps ch.] {([.ph] wff) ([.ps] wff) ([.ch] wff) (([.ph ps] iff) |-)})
