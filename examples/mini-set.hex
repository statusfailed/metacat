    ([.h0 h1 h2 p2 p3 h3 p4 p5] 3bitr3g [p6.])
    ([.h0 p0 p1 p6] con4bid [p7.])
    [.p7]})

  # notbi: |- ( ( ph <-> ps ) <-> ( -. ph <-> -. ps ) )
  (def notbi
    : ([ph ps.] {([.ph] wff) ([.ps] wff)})
    -> ([ph ps.] (({([.ph ps] iff) ({([.ph] -.) ([.ps] -.)} iff)} iff) |-))
    = {[h0 h1.]
    ([.h0 h1] wb [p0.])
