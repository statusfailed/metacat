  (arr df-or
    : ([ph ps.] {([.ph] wff) ([.ps] wff)})
    -> ([ph ps.] (({([.ph ps] or) ({([.ph] -.) [.ps]} =>)} iff) |-)))

  # wal: wff A. x ph
  (arr wal
    : ([ph x.] {([.ph] wff) ([.x] setvar)})
    -> ([ph x.] (([.x ph] forall) wff)))

