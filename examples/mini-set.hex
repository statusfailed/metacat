# Foundational logic/ZFC axioms and the proof of sp from Metamath's set.mm.
# Source: local set.mm (CC0, https://github.com/metamath/set.mm).
# SHA-256: e3a11bb9cc3d7d85ec3eed51efab405e217e622b212651b403f553b54d74fdd3
# Regenerate: python3 scripts/translate_metamath.py set.mm --mini
# Check every proof: cargo run -- check examples/mini-set.hex
#
# Scope: the 29 foundational ax-* declarations through ax-ac2, including
# redundant variants and weaker choice axioms; no ax-groth or mathbox axioms.
# Theorems are the dependency chain of sp, with the original proof DAGs.
# Definitions are df-bi, df-or, df-an and df-ex. Other notation appearing only
# in ax-cc/ax-dc is declared syntactically; its definitions are not ported here.
#
# wff/setvar/class are Metamath's floating hypotheses, retained as proof inputs;
# |- marks provability. cv embeds a set variable into class syntax. Names of
# connectives are adapted to hexpr: =>, iff, and, or, forall, exists, = and in.
# Each declaration's comment gives the original Metamath statement and $d pairs.
# h0, h1, ... are its hypotheses in Metamath order; p0, p1, ... are proof steps.
#
# DV annotations order syntax metavariables as B + C. An ar edge permits
# occurrence of a bare variable (B) in an ordinary metavariable (C). Derived
# interfaces use the full translator's proof-based bareness inference; redundant
# source $d conditions need not become annotations. sp needs no DV annotation.
# ax7v/ax7v1/ax7v2 are inlined to ax-7, preserving the original fragment's scope.
# fresh introduces a local set-variable hypothesis, not a provability axiom;
# its uses in equid and 19.8a discharge the original dummy-variable conditions.

(theory set.syntax nat {
  (arr wff : 1 -> 1)
  (arr setvar : 1 -> 1)
  (arr class : 1 -> 1)
  (arr |- : 1 -> 1)
  (arr -. : 1 -> 1)
  (arr => : 2 -> 1)
  (arr iff : 2 -> 1)
  (arr and : 2 -> 1)
  (arr or : 2 -> 1)
  (arr forall : 2 -> 1)
  (arr cv : 1 -> 1)
  (arr = : 2 -> 1)
  (arr exists : 2 -> 1)
  (arr in : 2 -> 1)
  (arr ne : 2 -> 1)
  (arr rforall : 3 -> 1)
  (arr subset : 2 -> 1)
  (arr empty : 0 -> 1)
  (arr rel : 3 -> 1)
  (arr dom : 1 -> 1)
  (arr ran : 1 -> 1)
  (arr suc : 1 -> 1)
  (arr apply : 2 -> 1)
  (arr omega : 0 -> 1)
  (arr equinumerosity : 0 -> 1)
})

(theory set.proof set.syntax {
  # A local set-variable declaration, used for Metamath's dummy variables.
  (arr fresh (dv del) : [x.] -> ([x] setvar))

  # wn: wff -. ph
  (arr wn
    : ([ph.] {([.ph] wff)})
    -> ([ph.] (([.ph] -.) wff)))

  # wi: wff ( ph -> ps )
  (arr wi
    : ([ph ps.] {([.ph] wff) ([.ps] wff)})
    -> ([ph ps.] (([.ph ps] =>) wff)))

  # ax-mp: |- ps
  (arr ax-mp
    : ([ph ps.] {([.ph] wff) ([.ps] wff) ([.ph] |-) (([.ph ps] =>) |-)})
    -> ([ph ps.] ([.ps] |-)))

  # ax-1: |- ( ph -> ( ps -> ph ) )
  (arr ax-1
    : ([ph ps.] {([.ph] wff) ([.ps] wff)})
    -> ([ph ps.] (({[.ph] ([.ps ph] =>)} =>) |-)))

  # ax-2: |- ( ( ph -> ( ps -> ch ) ) -> ( ( ph -> ps ) -> ( ph -> ch ) ) )
  (arr ax-2
    : ([ph ps ch.] {([.ph] wff) ([.ps] wff) ([.ch] wff)})
    -> ([ph ps ch.] (({({[.ph] ([.ps ch] =>)} =>) ({([.ph ps] =>) ([.ph ch] =>)} =>)} =>) |-)))

  # ax-3: |- ( ( -. ph -> -. ps ) -> ( ps -> ph ) )
  (arr ax-3
    : ([ph ps.] {([.ph] wff) ([.ps] wff)})
    -> ([ph ps.] (({({([.ph] -.) ([.ps] -.)} =>) ([.ps ph] =>)} =>) |-)))

  # mp2: |- ch
  (def mp2
    : ([ph ps ch.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.ph] |-) ([.ps] |-) (({[.ph] ([.ps ch] =>)} =>) |-)})
    -> ([ph ps ch.] ([.ch] |-))
    = {[h0 h1 h2 h3 h4 h5.]
    ([.h1 h2] wi [p0.])
    ([.h0 p0 h3 h5] ax-mp [p1.])
    ([.h1 h2 h4 p1] ax-mp [p2.])
    [.p2]})

  # a1i: |- ( ps -> ph )
  (def a1i
    : ([ph ps.] {([.ph] wff) ([.ps] wff) ([.ph] |-)})
    -> ([ph ps.] (([.ps ph] =>) |-))
    = {[h0 h1 h2.]
    ([.h1 h0] wi [p0.])
    ([.h0 h1] ax-1 [p1.])
    ([.h0 p0 h2 p1] ax-mp [p2.])
    [.p2]})

  # a2i: |- ( ( ph -> ps ) -> ( ph -> ch ) )
  (def a2i
    : ([ph ps ch.] {([.ph] wff) ([.ps] wff) ([.ch] wff) (({[.ph] ([.ps ch] =>)} =>) |-)})
    -> ([ph ps ch.] (({([.ph ps] =>) ([.ph ch] =>)} =>) |-))
    = {[h0 h1 h2 h3.]
    ([.h1 h2] wi [p0.])
    ([.h0 p0] wi [p1.])
    ([.h0 h1] wi [p2.])
    ([.h0 h2] wi [p3.])
    ([.p2 p3] wi [p4.])
    ([.h0 h1 h2] ax-2 [p5.])
    ([.p1 p4 h3 p5] ax-mp [p6.])
    [.p6]})

  # mpd: |- ( ph -> ch )
  (def mpd
    : ([ph ps ch.] {([.ph] wff) ([.ps] wff) ([.ch] wff) (([.ph ps] =>) |-) (({[.ph] ([.ps ch] =>)} =>) |-)})
    -> ([ph ps ch.] (([.ph ch] =>) |-))
    = {[h0 h1 h2 h3 h4.]
    ([.h0 h1] wi [p0.])
    ([.h0 h2] wi [p1.])
    ([.h0 h1 h2 h4] a2i [p2.])
    ([.p0 p1 h3 p2] ax-mp [p3.])
    [.p3]})

  # imim2i: |- ( ( ch -> ph ) -> ( ch -> ps ) )
  (def imim2i
    : ([ph ps ch.] {([.ph] wff) ([.ps] wff) ([.ch] wff) (([.ph ps] =>) |-)})
    -> ([ph ps ch.] (({([.ch ph] =>) ([.ch ps] =>)} =>) |-))
    = {[h0 h1 h2 h3.]
    ([.h0 h1] wi [p0.])
    ([.p0 h2 h3] a1i [p1.])
    ([.h2 h0 h1 p1] a2i [p2.])
    [.p2]})

  # syl: |- ( ph -> ch )
  (def syl
    : ([ph ps ch.] {([.ph] wff) ([.ps] wff) ([.ch] wff) (([.ph ps] =>) |-) (([.ps ch] =>) |-)})
    -> ([ph ps ch.] (([.ph ch] =>) |-))
    = {[h0 h1 h2 h3 h4.]
    ([.h1 h2] wi [p0.])
    ([.p0 h0 h4] a1i [p1.])
    ([.h0 h1 h2 h3 p1] mpd [p2.])
    [.p2]})

  # mpi: |- ( ph -> ch )
  (def mpi
    : ([ph ps ch.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.ps] |-) (({[.ph] ([.ps ch] =>)} =>) |-)})
    -> ([ph ps ch.] (([.ph ch] =>) |-))
    = {[h0 h1 h2 h3 h4.]
    ([.h1 h0 h3] a1i [p0.])
    ([.h0 h1 h2 p0 h4] mpd [p1.])
    [.p1]})

  # id: |- ( ph -> ph )
  (def id
    : ([ph.] {([.ph] wff)})
    -> ([ph.] (([.ph ph] =>) |-))
    = {[h0.]
    ([.h0 h0] wi [p0.])
    ([.h0 h0] ax-1 [p1.])
    ([.h0 p0] ax-1 [p2.])
    ([.h0 p0 h0 p1 p2] mpd [p3.])
    [.p3]})

  # idd: |- ( ph -> ( ps -> ps ) )
  (def idd
    : ([ph ps.] {([.ph] wff) ([.ps] wff)})
    -> ([ph ps.] (({[.ph] ([.ps ps] =>)} =>) |-))
    = {[h0 h1.]
    ([.h1 h1] wi [p0.])
    ([.h1] id [p1.])
    ([.p0 h0 p1] a1i [p2.])
    [.p2]})

  # a1d: |- ( ph -> ( ch -> ps ) )
  (def a1d
    : ([ph ps ch.] {([.ph] wff) ([.ps] wff) ([.ch] wff) (([.ph ps] =>) |-)})
    -> ([ph ps ch.] (({[.ph] ([.ch ps] =>)} =>) |-))
    = {[h0 h1 h2 h3.]
    ([.h2 h1] wi [p0.])
    ([.h1 h2] ax-1 [p1.])
    ([.h0 h1 p0 h3 p1] syl [p2.])
    [.p2]})

  # a2d: |- ( ph -> ( ( ps -> ch ) -> ( ps -> th ) ) )
  (def a2d
    : ([ph ps ch th.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) (({[.ph] ({[.ps] ([.ch th] =>)} =>)} =>) |-)})
    -> ([ph ps ch th.] (({[.ph] ({([.ps ch] =>) ([.ps th] =>)} =>)} =>) |-))
    = {[h0 h1 h2 h3 h4.]
    ([.h2 h3] wi [p0.])
    ([.h1 p0] wi [p1.])
    ([.h1 h2] wi [p2.])
    ([.h1 h3] wi [p3.])
    ([.p2 p3] wi [p4.])
    ([.h1 h2 h3] ax-2 [p5.])
    ([.h0 p1 p4 h4 p5] syl [p6.])
    [.p6]})

  # sylcom: |- ( ph -> ( ps -> th ) )
  (def sylcom
    : ([ph ps ch th.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) (({[.ph] ([.ps ch] =>)} =>) |-) (({[.ps] ([.ch th] =>)} =>) |-)})
    -> ([ph ps ch th.] (({[.ph] ([.ps th] =>)} =>) |-))
    = {[h0 h1 h2 h3 h4 h5.]
    ([.h1 h2] wi [p0.])
    ([.h1 h3] wi [p1.])
    ([.h1 h2 h3 h5] a2i [p2.])
    ([.h0 p0 p1 h4 p2] syl [p3.])
    [.p3]})

  # syl5com: |- ( ph -> ( ch -> th ) )
  (def syl5com
    : ([ph ps ch th.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) (([.ph ps] =>) |-) (({[.ch] ([.ps th] =>)} =>) |-)})
    -> ([ph ps ch th.] (({[.ph] ([.ch th] =>)} =>) |-))
    = {[h0 h1 h2 h3 h4 h5.]
    ([.h0 h1 h2 h4] a1d [p0.])
    ([.h0 h2 h1 h3 p0 h5] sylcom [p1.])
    [.p1]})

  # com12: |- ( ps -> ( ph -> ch ) )
  (def com12
    : ([ph ps ch.] {([.ph] wff) ([.ps] wff) ([.ch] wff) (({[.ph] ([.ps ch] =>)} =>) |-)})
    -> ([ph ps ch.] (({[.ps] ([.ph ch] =>)} =>) |-))
    = {[h0 h1 h2 h3.]
    ([.h1] id [p0.])
    ([.h1 h1 h0 h2 p0 h3] syl5com [p1.])
    [.p1]})

  # syl5: |- ( ch -> ( ph -> th ) )
  (def syl5
    : ([ph ps ch th.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) (([.ph ps] =>) |-) (({[.ch] ([.ps th] =>)} =>) |-)})
    -> ([ph ps ch th.] (({[.ch] ([.ph th] =>)} =>) |-))
    = {[h0 h1 h2 h3 h4 h5.]
    ([.h0 h1 h2 h3 h4 h5] syl5com [p0.])
    ([.h0 h2 h3 p0] com12 [p1.])
    [.p1]})

  # syl6: |- ( ph -> ( ps -> th ) )
  (def syl6
    : ([ph ps ch th.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) (({[.ph] ([.ps ch] =>)} =>) |-) (([.ch th] =>) |-)})
    -> ([ph ps ch th.] (({[.ph] ([.ps th] =>)} =>) |-))
    = {[h0 h1 h2 h3 h4 h5.]
    ([.h2 h3] wi [p0.])
    ([.p0 h1 h5] a1i [p1.])
    ([.h0 h1 h2 h3 h4 p1] sylcom [p2.])
    [.p2]})

  # syl2im: |- ( ph -> ( ch -> ta ) )
  (def syl2im
    : ([ph ps ch th ta.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) ([.ta] wff) (([.ph ps] =>) |-) (([.ch th] =>) |-) (({[.ps] ([.th ta] =>)} =>) |-)})
    -> ([ph ps ch th ta.] (({[.ph] ([.ch ta] =>)} =>) |-))
    = {[h0 h1 h2 h3 h4 h5 h6 h7.]
    ([.h2 h4] wi [p0.])
    ([.h2 h3 h1 h4 h6 h7] syl5 [p1.])
    ([.h0 h1 p0 h5 p1] syl [p2.])
    [.p2]})

  # syl2imc: |- ( ch -> ( ph -> ta ) )
  (def syl2imc
    : ([ph ps ch th ta.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) ([.ta] wff) (([.ph ps] =>) |-) (([.ch th] =>) |-) (({[.ps] ([.th ta] =>)} =>) |-)})
    -> ([ph ps ch th ta.] (({[.ch] ([.ph ta] =>)} =>) |-))
    = {[h0 h1 h2 h3 h4 h5 h6 h7.]
    ([.h0 h1 h2 h3 h4 h5 h6 h7] syl2im [p0.])
    ([.h0 h2 h4 p0] com12 [p1.])
    [.p1]})

  # pm2.27: |- ( ph -> ( ( ph -> ps ) -> ps ) )
  (def pm2.27
    : ([ph ps.] {([.ph] wff) ([.ps] wff)})
    -> ([ph ps.] (({[.ph] ({([.ph ps] =>) [.ps]} =>)} =>) |-))
    = {[h0 h1.]
    ([.h0 h1] wi [p0.])
    ([.p0] id [p1.])
    ([.p0 h0 h1 p1] com12 [p2.])
    [.p2]})

  # mpdd: |- ( ph -> ( ps -> th ) )
  (def mpdd
    : ([ph ps ch th.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) (({[.ph] ([.ps ch] =>)} =>) |-) (({[.ph] ({[.ps] ([.ch th] =>)} =>)} =>) |-)})
    -> ([ph ps ch th.] (({[.ph] ([.ps th] =>)} =>) |-))
    = {[h0 h1 h2 h3 h4 h5.]
    ([.h1 h2] wi [p0.])
    ([.h1 h3] wi [p1.])
    ([.h0 h1 h2 h3 h5] a2d [p2.])
    ([.h0 p0 p1 h4 p2] mpd [p3.])
    [.p3]})

  # syld: |- ( ph -> ( ps -> th ) )
  (def syld
    : ([ph ps ch th.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) (({[.ph] ([.ps ch] =>)} =>) |-) (({[.ph] ([.ch th] =>)} =>) |-)})
    -> ([ph ps ch th.] (({[.ph] ([.ps th] =>)} =>) |-))
    = {[h0 h1 h2 h3 h4 h5.]
    ([.h2 h3] wi [p0.])
    ([.h0 p0 h1 h5] a1d [p1.])
    ([.h0 h1 h2 h3 h4 p1] mpdd [p2.])
    [.p2]})

  # pm2.43i: |- ( ph -> ps )
  (def pm2.43i
    : ([ph ps.] {([.ph] wff) ([.ps] wff) (({[.ph] ([.ph ps] =>)} =>) |-)})
    -> ([ph ps.] (([.ph ps] =>) |-))
    = {[h0 h1 h2.]
    ([.h0] id [p0.])
    ([.h0 h0 h1 p0 h2] mpd [p1.])
    [.p1]})

  # imim2d: |- ( ph -> ( ( th -> ps ) -> ( th -> ch ) ) )
  (def imim2d
    : ([ph ps ch th.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) (({[.ph] ([.ps ch] =>)} =>) |-)})
    -> ([ph ps ch th.] (({[.ph] ({([.th ps] =>) ([.th ch] =>)} =>)} =>) |-))
    = {[h0 h1 h2 h3 h4.]
    ([.h1 h2] wi [p0.])
    ([.h0 p0 h3 h4] a1d [p1.])
    ([.h0 h3 h1 h2 p1] a2d [p2.])
    [.p2]})

  # imim2: |- ( ( ph -> ps ) -> ( ( ch -> ph ) -> ( ch -> ps ) ) )
  (def imim2
    : ([ph ps ch.] {([.ph] wff) ([.ps] wff) ([.ch] wff)})
    -> ([ph ps ch.] (({([.ph ps] =>) ({([.ch ph] =>) ([.ch ps] =>)} =>)} =>) |-))
    = {[h0 h1 h2.]
    ([.h0 h1] wi [p0.])
    ([.p0] id [p1.])
    ([.p0 h0 h1 h2 p1] imim2d [p2.])
    [.p2]})

  # imim3i: |- ( ( th -> ph ) -> ( ( th -> ps ) -> ( th -> ch ) ) )
  (def imim3i
    : ([ph ps ch th.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) (({[.ph] ([.ps ch] =>)} =>) |-)})
    -> ([ph ps ch th.] (({([.th ph] =>) ({([.th ps] =>) ([.th ch] =>)} =>)} =>) |-))
    = {[h0 h1 h2 h3 h4.]
    ([.h3 h0] wi [p0.])
    ([.h1 h2] wi [p1.])
    ([.h0 p1 h3 h4] imim2i [p2.])
    ([.p0 h3 h1 h2 p2] a2d [p3.])
    [.p3]})

  # syl6c: |- ( ph -> ( ps -> ta ) )
  (def syl6c
    : ([ph ps ch th ta.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) ([.ta] wff) (({[.ph] ([.ps ch] =>)} =>) |-) (({[.ph] ([.ps th] =>)} =>) |-) (({[.ch] ([.th ta] =>)} =>) |-)})
    -> ([ph ps ch th ta.] (({[.ph] ([.ps ta] =>)} =>) |-))
    = {[h0 h1 h2 h3 h4 h5 h6 h7.]
    ([.h3 h4] wi [p0.])
    ([.h0 h1 h2 p0 h5 h7] syl6 [p1.])
    ([.h0 h1 h3 h4 h6 p1] mpdd [p2.])
    [.p2]})

  # syldd: |- ( ph -> ( ps -> ( ch -> ta ) ) )
  (def syldd
    : ([ph ps ch th ta.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) ([.ta] wff) (({[.ph] ({[.ps] ([.ch th] =>)} =>)} =>) |-) (({[.ph] ({[.ps] ([.th ta] =>)} =>)} =>) |-)})
    -> ([ph ps ch th ta.] (({[.ph] ({[.ps] ([.ch ta] =>)} =>)} =>) |-))
    = {[h0 h1 h2 h3 h4 h5 h6.]
    ([.h3 h4] wi [p0.])
    ([.h2 h3] wi [p1.])
    ([.h2 h4] wi [p2.])
    ([.h3 h4 h2] imim2 [p3.])
    ([.h0 h1 p0 p1 p2 h6 h5 p3] syl6c [p4.])
    [.p4]})

  # syl5d: |- ( ph -> ( th -> ( ps -> ta ) ) )
  (def syl5d
    : ([ph ps ch th ta.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) ([.ta] wff) (({[.ph] ([.ps ch] =>)} =>) |-) (({[.ph] ({[.th] ([.ch ta] =>)} =>)} =>) |-)})
    -> ([ph ps ch th ta.] (({[.ph] ({[.th] ([.ps ta] =>)} =>)} =>) |-))
    = {[h0 h1 h2 h3 h4 h5 h6.]
    ([.h1 h2] wi [p0.])
    ([.h0 p0 h3 h5] a1d [p1.])
    ([.h0 h3 h1 h2 h4 p1 h6] syldd [p2.])
    [.p2]})

  # syl9: |- ( ph -> ( th -> ( ps -> ta ) ) )
  (def syl9
    : ([ph ps ch th ta.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) ([.ta] wff) (({[.ph] ([.ps ch] =>)} =>) |-) (({[.th] ([.ch ta] =>)} =>) |-)})
    -> ([ph ps ch th ta.] (({[.ph] ({[.th] ([.ps ta] =>)} =>)} =>) |-))
    = {[h0 h1 h2 h3 h4 h5 h6.]
    ([.h2 h4] wi [p0.])
    ([.h3 p0] wi [p1.])
    ([.p1 h0 h6] a1i [p2.])
    ([.h0 h1 h2 h3 h4 h5 p2] syl5d [p3.])
    [.p3]})

  # imim12d: |- ( ph -> ( ( ch -> th ) -> ( ps -> ta ) ) )
  (def imim12d
    : ([ph ps ch th ta.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) ([.ta] wff) (({[.ph] ([.ps ch] =>)} =>) |-) (({[.ph] ([.th ta] =>)} =>) |-)})
    -> ([ph ps ch th ta.] (({[.ph] ({([.ch th] =>) ([.ps ta] =>)} =>)} =>) |-))
    = {[h0 h1 h2 h3 h4 h5 h6.]
    ([.h2 h3] wi [p0.])
    ([.h0 h3 h4 h2 h6] imim2d [p1.])
    ([.h0 h1 h2 p0 h4 h5 p1] syl5d [p2.])
    [.p2]})

  # imim1d: |- ( ph -> ( ( ch -> th ) -> ( ps -> th ) ) )
  (def imim1d
    : ([ph ps ch th.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) (({[.ph] ([.ps ch] =>)} =>) |-)})
    -> ([ph ps ch th.] (({[.ph] ({([.ch th] =>) ([.ps th] =>)} =>)} =>) |-))
    = {[h0 h1 h2 h3 h4.]
    ([.h0 h3] idd [p0.])
    ([.h0 h1 h2 h3 h3 h4 p0] imim12d [p1.])
    [.p1]})

  # com23: |- ( ph -> ( ch -> ( ps -> th ) ) )
  (def com23
    : ([ph ps ch th.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) (({[.ph] ({[.ps] ([.ch th] =>)} =>)} =>) |-)})
    -> ([ph ps ch th.] (({[.ph] ({[.ch] ([.ps th] =>)} =>)} =>) |-))
    = {[h0 h1 h2 h3 h4.]
    ([.h2 h3] wi [p0.])
    ([.h2 h3] pm2.27 [p1.])
    ([.h0 h1 p0 h2 h3 h4 p1] syl9 [p2.])
    [.p2]})

  # pm2.86d: |- ( ph -> ( ps -> ( ch -> th ) ) )
  (def pm2.86d
    : ([ph ps ch th.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) (({[.ph] ({([.ps ch] =>) ([.ps th] =>)} =>)} =>) |-)})
    -> ([ph ps ch th.] (({[.ph] ({[.ps] ([.ch th] =>)} =>)} =>) |-))
    = {[h0 h1 h2 h3 h4.]
    ([.h1 h2] wi [p0.])
    ([.h1 h3] wi [p1.])
