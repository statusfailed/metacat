    ([.h0 h1 h2 h4] biimpd [p4.])
    ([.h0 h1 h2 h3 p4] imim1d [p5.])
    ([.h0 p0 p1 p3 p5] impbid [p6.])
    [.p6]})

  # imbi1: |- ( ( ph <-> ps ) -> ( ( ph -> ch ) <-> ( ps -> ch ) ) )
  (def imbi1
    : ([ph ps ch.] {([.ph] wff) ([.ps] wff) ([.ch] wff)})
