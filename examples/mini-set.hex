  # xchbinxr: |- ( ph <-> -. ch )
  (def xchbinxr
    : ([ph ps ch.] {([.ph] wff) ([.ps] wff) ([.ch] wff) (({[.ph] ([.ps] -.)} iff) |-) (([.ch ps] iff) |-)})
    -> ([ph ps ch.] (({[.ph] ([.ch] -.)} iff) |-))
