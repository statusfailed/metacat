    ([.p0 p3 h2 p4] mpbi [p5.])
    [.p5]})

  # xchbinx: |- ( ph <-> -. ch )
  (def xchbinx
    : ([ph ps ch.] {([.ph] wff) ([.ps] wff) ([.ch] wff) (({[.ph] ([.ps] -.)} iff) |-) (([.ps ch] iff) |-)})
    -> ([ph ps ch.] (({[.ph] ([.ch] -.)} iff) |-))
