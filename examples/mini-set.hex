  # imbi1d: |- ( ph -> ( ( ps -> th ) <-> ( ch -> th ) ) )
  (def imbi1d
    : ([ph ps ch th.] {([.ph] wff) ([.ps] wff) ([.ch] wff) ([.th] wff) (({[.ph] ([.ps ch] iff)} =>) |-)})
    -> ([ph ps ch th.] (({[.ph] ({([.ps th] =>) ([.ch th] =>)} iff)} =>) |-))
    = {[h0 h1 h2 h3 h4.]
