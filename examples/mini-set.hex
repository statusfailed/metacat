    ([.p0 p3 p5 p7] impbii [p8.])
    [.p8]})

  # notbii: |- ( -. ph <-> -. ps )
  (def notbii
    : ([ph ps.] {([.ph] wff) ([.ps] wff) (([.ph ps] iff) |-)})
    -> ([ph ps.] (({([.ph] -.) ([.ps] -.)} iff) |-))
