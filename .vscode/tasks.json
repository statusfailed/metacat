{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build metacat vscode dev",
      "dependsOrder": "sequence",
      "dependsOn": [
        "cargo: build metacat-lsp",
        "npm: compile metacat-vscode"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "cargo: build metacat-lsp",
      "type": "shell",
      "command": "cargo build -p metacat-lsp",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "npm: compile metacat-vscode",
      "type": "shell",
      "command": "npm run compile",
      "options": {
        "cwd": "${workspaceFolder}/metacat-vscode"
      },
      "group": "build",
      "problemMatcher": "$tsc"
    }
  ]
}
